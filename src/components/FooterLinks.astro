---

<nav class="footer-links" aria-label="Social and contact links">
  {links.map(link => (
    <a
      class="footer-link"
      href={link.href}
      aria-label={link.label}
      title={link.label}
      target={link.href.startsWith('mailto:') ? undefined : '_blank'}
      rel={link.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
    >
      {[false, true].map(reveal => (
        <span class:list={['icon-layer', { 'icon-layer--reveal': reveal }]} aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill={link.filled ? 'currentColor' : 'none'}
            stroke={link.filled ? undefined : 'currentColor'}
            stroke-width={link.filled ? undefined : 1.6}
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            {link.paths.map(d => <path d={d} />)}
          </svg>
        </span>
      ))}
    </a>
  ))}
</nav>

<style>
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .footer-link {
    display: grid;
    flex: 0 0 var(--touch-target);
    width: var(--touch-target);
    height: var(--touch-target);
    border-radius: var(--radius-small);
    color: var(--fg);
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-position: left center;
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: background-size 220ms ease;
  }

  .icon-layer {
    display: grid;
    grid-area: 1 / 1;
    place-items: center;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Clip the full hit area so the white icon follows the background sweep. */
  .icon-layer--reveal {
    color: var(--on-accent);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 220ms ease;
  }

  .footer-link:is(:hover, :focus-visible) {
    background-size: 100% 100%;
  }

  .footer-link:is(:hover, :focus-visible) .icon-layer--reveal {
    clip-path: inset(0);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: var(--space-1);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link,
    .icon-layer--reveal {
      transition: none;
    }
  }

  @media (forced-colors: active) {
    .footer-link {
      color: LinkText;
      background: none;
    }

    .icon-layer--reveal {
      display: none;
    }
  }
</style>
