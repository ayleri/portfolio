<ascii-ocean class="ascii-ocean" hidden>
  <canvas aria-hidden="true"></canvas>
  <div class="ocean-controls">
    <button class="ocean-button ocean-pause" type="button" aria-label="Pause ocean animation" title="Pause ocean animation">
      <svg class="ocean-pause-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M5 3v10M11 3v10" fill="none" stroke="currentColor" stroke-width="2" />
      </svg>
      <svg class="ocean-play-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
        <path d="M5 3l8 5-8 5z" fill="currentColor" />
      </svg>
    </button>
  </div>
</ascii-ocean>

<style>
  @font-face {
    font-family: 'JetBrains Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/jetbrains-mono-regular.woff2') format('woff2');
  }

  .ascii-ocean {
    display: contents;
  }

  .ascii-ocean[hidden] {
    display: none;
  }

  canvas {
    /* On narrow screens, blend into the column rather than only across the gutter. */
    --column-start: max(min(25%, var(--space-24)), calc((100% - var(--maxw)) / 2));
    --column-end: calc(100% - var(--column-start));
    --fade-width: min(calc(var(--space-16) * 4), var(--column-start));
    display: block;
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
    font-weight: 400;
    /* A wide, eased fade keeps the grid from forming a band at the column edge. */
    mask-image: linear-gradient(to right,
      rgb(0 0 0),
      rgb(0 0 0) calc(var(--column-start) - var(--fade-width)),
      rgb(0 0 0 / 0.875) calc(var(--column-start) - var(--fade-width) * 0.75),
      rgb(0 0 0 / 0.6) calc(var(--column-start) - var(--fade-width) * 0.5),
      rgb(0 0 0 / 0.325) calc(var(--column-start) - var(--fade-width) * 0.25),
      rgb(0 0 0 / 0.2) var(--column-start),
      rgb(0 0 0 / 0.2) var(--column-end),
      rgb(0 0 0 / 0.325) calc(var(--column-end) + var(--fade-width) * 0.25),
      rgb(0 0 0 / 0.6) calc(var(--column-end) + var(--fade-width) * 0.5),
      rgb(0 0 0 / 0.875) calc(var(--column-end) + var(--fade-width) * 0.75),
      rgb(0 0 0) calc(var(--column-end) + var(--fade-width)),
      rgb(0 0 0));
  }

  .ocean-controls {
    position: fixed;
    bottom: max(var(--space-5), env(safe-area-inset-bottom));
    right: max(var(--space-5), env(safe-area-inset-right));
    z-index: 2;
    display: flex;
    gap: var(--space-2);
  }

  .ocean-button {
    display: grid;
    place-items: center;
    width: var(--touch-target);
    height: var(--touch-target);
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    background: var(--bg);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 16px;
    font-weight: var(--sans-weight);
    line-height: 1;
    cursor: pointer;
  }

  .ocean-button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .ocean-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: var(--space-1);
  }

  .ocean-play-icon,
  [data-paused] .ocean-pause-icon,
  .ocean-pause[hidden] {
    display: none;
  }

  [data-paused] .ocean-play-icon {
    display: block;
  }

  @media print, (forced-colors: active) {
    .ascii-ocean {
      display: none;
    }
  }
</style>

<script src="../../js/ascii-ocean.mjs"></script>
